{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/component-registry.schema.json",
  "title": "QenTerra component registry",
  "type": "object",
  "required": ["$schema", "version", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "anatomy", "states", "stories", "accessibility"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "name": {"type": "object", "required": ["en", "ru"], "properties": {"en": {"type": "string"}, "ru": {"type": "string"}}, "additionalProperties": false},
          "summary": {"type": "object", "required": ["en", "ru"], "properties": {"en": {"type": "string"}, "ru": {"type": "string"}}, "additionalProperties": false},
          "anatomy": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "state"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
                "state": {"type": "string"},
                "variant": {"type": "string"},
                "localeWidth": {"enum": ["standard", "long", "rtl"]}
              },
              "additionalProperties": false
            }
          },
          "accessibility": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
