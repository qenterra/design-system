{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/component-registry.schema.json",
  "title": "QenTerra component registry",
  "type": "object",
  "required": ["$schema", "version", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary", "status", "category", "platforms", "lifecycle", "anatomy", "states", "stories", "keyboard", "accessibility", "localization", "evidence", "delivery"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "name": {"$ref": "#/$defs/localized"},
          "summary": {"$ref": "#/$defs/localized"},
          "status": {"enum": ["stable", "beta", "deprecated"]},
          "category": {"enum": ["control", "input", "navigation", "overlay", "feedback", "layout"]},
          "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["macOS", "iOS", "iPadOS", "web"]}},
          "lifecycle": {
            "type": "object",
            "required": ["introduced", "review"],
            "properties": {
              "introduced": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "review": {"enum": ["minor", "major"]},
              "replacement": {"type": "string"}
            },
            "additionalProperties": false
          },
          "anatomy": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "stories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "state"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
                "state": {"type": "string"},
                "variant": {"type": "string"},
                "localeWidth": {"enum": ["standard", "long", "rtl"]}
              },
              "additionalProperties": false
            }
          },
          "keyboard": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "accessibility": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "localization": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["schema", "unit", "manual"]}},
          "delivery": {
            "type": "object",
            "required": ["status", "packages"],
            "properties": {
              "status": {"enum": ["delivered", "specification-only"]},
              "packages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "ru"],
      "properties": {"en": {"type": "string", "minLength": 1}, "ru": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
