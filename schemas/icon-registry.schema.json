{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/icon-registry.schema.json",
  "title": "QDS semantic icon registry",
  "type": "object",
  "required": ["$schema", "version", "viewBox", "icons"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "viewBox": {"type": "string", "enum": ["0 0 16 16"]},
    "icons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "svg", "category", "meaning"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "svg": {"type": "string", "minLength": 10},
          "category": {"type": "string", "enum": ["navigation", "action", "status", "chrome"]},
          "meaning": {"type": "string", "minLength": 6}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
