{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.com/schemas/package-release-manifest.schema.json",
  "title": "QDS Private Package Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceSha", "swift", "npm", "status", "manualNotProven"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "swift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSha", "payloadSha256"],
      "properties": {
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "npm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "payloadSha256", "files"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "status": { "const": "verified" },
    "manualNotProven": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
