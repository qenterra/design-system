{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.dev/schemas/reui-registry.schema.json",
  "title": "ReUI exact source catalog",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "source",
    "upstreamRepository",
    "upstreamRef",
    "upstreamCommit",
    "registryOrigin",
    "registryRevision",
    "registryIndexes",
    "scope",
    "bases",
    "count",
    "exampleCount",
    "primitiveCount",
    "hookCount",
    "repositoryItemCount",
    "liveRegistryItemCount",
    "sourceFileCount",
    "registryItemCount",
    "fileCount",
    "categories",
    "license",
    "sources",
    "items"
  ],
  "properties": {
    "$schema": {"const": "../schemas/reui-registry.schema.json"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"const": "https://reui.io/components"},
    "upstreamRepository": {"const": "https://github.com/keenthemes/reui"},
    "upstreamRef": {"const": "refs/heads/main"},
    "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "registryOrigin": {"const": "https://reui.io/r/styles"},
    "registryRevision": {"type": "string", "pattern": "^dpl_[A-Za-z0-9_]+$"},
    "registryIndexes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["base", "style", "upstreamPath", "sourceURL", "sha256", "bytes"],
        "properties": {
          "base": {"enum": ["base", "radix"]},
          "style": {"enum": ["base-nova", "radix-nova"]},
          "upstreamPath": {"type": "string", "pattern": "^public/r/styles/(base|radix)-nova/registry\\.json$"},
          "sourceURL": {"type": "string", "pattern": "^https://reui\\.io/r/styles/(base|radix)-nova/registry\\.json\\?v=dpl_[A-Za-z0-9_]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "bases": {"const": ["base", "radix"]},
    "count": {"type": "integer", "minimum": 1},
    "exampleCount": {"type": "integer", "minimum": 1},
    "primitiveCount": {"type": "integer", "minimum": 1},
    "hookCount": {"type": "integer", "minimum": 1},
    "repositoryItemCount": {"type": "integer", "minimum": 1},
    "liveRegistryItemCount": {"type": "integer", "minimum": 1},
    "sourceFileCount": {"type": "integer", "minimum": 1},
    "registryItemCount": {"type": "integer", "minimum": 1},
    "fileCount": {"type": "integer", "minimum": 1},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["identifier", "count"],
        "properties": {
          "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx", "copyright", "upstreamPath", "sourceURL", "sourcePath", "sha256", "bytes"],
      "properties": {
        "spdx": {"const": "MIT"},
        "copyright": {"const": "Copyright (c) 2025 Keenthemes Inc"},
        "upstreamPath": {"const": "LICENSE.md"},
        "sourceURL": {"type": "string", "pattern": "^https://github\\.com/keenthemes/reui/blob/[0-9a-f]{40}/LICENSE\\.md$"},
        "sourcePath": {"const": "Sources/ReUI/LICENSE.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "base", "style", "kind", "title", "description", "categories", "language", "documentationURL", "dependencies", "registryDependencies", "sourcePaths", "registryItem"],
        "properties": {
          "id": {"type": "string", "pattern": "^(base|radix):[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "base": {"enum": ["base", "radix"]},
          "style": {"enum": ["base-nova", "radix-nova"]},
          "kind": {"enum": ["example", "primitive", "hook"]},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "categories": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
          },
          "language": {"const": "TypeScript"},
          "documentationURL": {"const": "https://reui.io/components"},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "registryDependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^Sources/ReUI/(Base|Radix|Shared)/.+\\.(ts|tsx)$"}
          },
          "registryItem": {
            "type": "object",
            "required": ["origin", "upstreamPath", "sourceURL", "sourcePath", "sha256", "bytes"],
            "properties": {
              "origin": {"enum": ["repository", "live-registry"]},
              "upstreamPath": {"type": "string", "pattern": "^public/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json$"},
              "sourceURL": {"type": "string", "pattern": "^(https://raw\\.githubusercontent\\.com/keenthemes/reui/[0-9a-f]{40}/public/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json|https://reui\\.io/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json\\?v=dpl_[A-Za-z0-9_]+)$"},
              "sourcePath": {"type": "string", "pattern": "^Sources/ReUI/Registry/(Base|Radix)Nova/[a-z0-9][a-z0-9-]*\\.json$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["origin", "upstreamPath", "sourceURL", "sourcePath", "sha256", "bytes"],
      "properties": {
        "origin": {"enum": ["repository", "live-registry"]},
        "upstreamPath": {"type": "string", "pattern": "^public/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json#target=.+\\.(ts|tsx)$"},
        "sourceURL": {"type": "string", "pattern": "^(https://raw\\.githubusercontent\\.com/keenthemes/reui/[0-9a-f]{40}/public/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json|https://reui\\.io/r/styles/(base|radix)-nova/[a-z0-9][a-z0-9-]*\\.json\\?v=dpl_[A-Za-z0-9_]+)$"},
        "sourcePath": {"type": "string", "pattern": "^Sources/ReUI/(Base|Radix|Shared)/.+\\.(ts|tsx)$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
