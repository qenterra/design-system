{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/contact-channels.schema.json",
  "title": "QenTerra contact channels",
  "type": "object",
  "required": ["$schema", "version", "channels"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "channels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "address", "purpose", "useFor", "doNotUseFor"],
        "properties": {
          "id": {"type": "string", "enum": ["contact", "support"]},
          "address": {"type": "string", "pattern": "^[a-z]+@qenterra\\.com$"},
          "purpose": {"type": "string", "minLength": 12},
          "useFor": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "doNotUseFor": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
