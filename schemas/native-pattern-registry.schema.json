{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/native-pattern-registry.schema.json",
  "title": "Explore SwiftUI exact-source registry",
  "type": "object",
  "required": ["$schema", "version", "source", "sitemap", "count", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"const": "https://exploreswiftui.com/"},
    "sitemap": {"const": "https://exploreswiftui.com/sitemap.xml"},
    "count": {"type": "integer", "minimum": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "pageURL", "description", "appleDocumentationURL", "programmingLanguage", "runtimePlatform", "publishedAt", "updatedAt", "tags", "platforms", "sourcePath", "sha256", "bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
          "pageURL": {"type": "string", "pattern": "^https://exploreswiftui\\.com/library/.+$"},
          "description": {"type": "string"},
          "appleDocumentationURL": {"type": "string"},
          "programmingLanguage": {"type": "string"},
          "runtimePlatform": {"type": "string"},
          "publishedAt": {"type": "string"},
          "updatedAt": {"type": "string"},
          "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "platforms": {
            "type": "object",
            "properties": {
              "iOS": {"type": "string"},
              "iPadOS": {"type": "string"},
              "macOS": {"type": "string"},
              "watchOS": {"type": "string"},
              "tvOS": {"type": "string"},
              "visionOS": {"type": "string"}
            },
            "additionalProperties": false
          },
          "sourcePath": {"type": "string", "pattern": "^Sources/ExploreSwiftUI/Components/[A-Za-z0-9/]+\\.swift$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
