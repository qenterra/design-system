{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/package-registry.schema.json",
  "title": "Design System package registry",
  "type": "object",
  "required": ["$schema", "version", "repository", "versionPolicy", "packages"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repository": {"type": "string", "const": "https://github.com/qenterra/packages"},
    "versionPolicy": {"enum": ["shared"]},
    "packages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "ecosystem", "name", "version", "publicPaths", "tests", "capabilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "ecosystem": {"enum": ["repository", "npm", "swiftpm"]},
          "name": {"type": "string", "minLength": 2},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "products": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "publicPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^packages/"}},
          "tests": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
