{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/qenterra-component-registry.schema.json",
  "title": "QenTerra packaged component registry",
  "type": "object",
  "required": ["$schema", "version", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status", "sourcePath", "publicSymbols", "designTokens"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$"},
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "status": {"enum": ["draft", "stable", "deprecated"]},
          "sourcePath": {"type": "string", "pattern": "^packages/Sources/QenTerra/Components/[A-Za-z0-9_/]+\\.swift$"},
          "publicSymbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "designTokens": {"type": "boolean"},
          "derivedFrom": {
            "type": "object",
            "required": ["provider", "componentId", "pageURL", "sourceSha256"],
            "properties": {
              "provider": {"const": "Explore SwiftUI"},
              "componentId": {"type": "string"},
              "pageURL": {"type": "string", "pattern": "^https://exploreswiftui\\.com/library/.+$"},
              "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
