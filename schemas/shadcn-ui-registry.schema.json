{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/shadcn-ui-registry.schema.json",
  "title": "shadcn/ui exact-source registry",
  "type": "object",
  "required": ["$schema", "version", "source", "upstreamRepository", "upstreamRef", "upstreamCommit", "scope", "count", "fileCount", "variants", "license", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"const": "https://ui.shadcn.com/"},
    "upstreamRepository": {"const": "https://github.com/shadcn-ui/ui"},
    "upstreamRef": {"const": "refs/heads/main"},
    "upstreamCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {"const": "official registry:ui component sources for every declared base"},
    "count": {"type": "integer", "minimum": 1},
    "fileCount": {"type": "integer", "minimum": 1},
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "count"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx", "copyright", "upstreamPath", "sourceURL", "sourcePath", "sha256", "bytes"],
      "properties": {
        "spdx": {"const": "MIT"},
        "copyright": {"type": "string", "pattern": "^Copyright \\(c\\) .+shadcn$"},
        "upstreamPath": {"const": "LICENSE.md"},
        "sourceURL": {"type": "string", "pattern": "^https://github\\.com/shadcn-ui/ui/blob/[0-9a-f]{40}/LICENSE\\.md$"},
        "sourcePath": {"const": "Sources/ShadcnUI/LICENSE.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "variant", "variantTitle", "language", "upstreamPath", "sourceURL", "sourcePath", "sha256", "bytes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9][a-z0-9/_-]*$"},
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "variant": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "variantTitle": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "upstreamPath": {"type": "string", "pattern": "^apps/v4/registry/bases/[a-z0-9-]+/ui/.+\\.(css|js|jsx|ts|tsx)$"},
          "sourceURL": {"type": "string", "pattern": "^https://raw\\.githubusercontent\\.com/shadcn-ui/ui/[0-9a-f]{40}/apps/v4/registry/bases/[a-z0-9-]+/ui/.+\\.(css|js|jsx|ts|tsx)$"},
          "sourcePath": {"type": "string", "pattern": "^Sources/ShadcnUI/Components/[A-Za-z0-9]+/.+\\.(css|js|jsx|ts|tsx)$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
