{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qenterra.local/schemas/email-templates.schema.json",
  "title": "QenTerra human-operated email templates",
  "type": "object",
  "required": ["$schema", "version", "capabilities", "fields", "templates"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/field"}
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/template"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "capabilities": {
      "type": "object",
      "required": ["sendsEmail", "persistsInput", "externalRequests", "marketing"],
      "properties": {
        "sendsEmail": {"type": "boolean", "enum": [false]},
        "persistsInput": {"type": "boolean", "enum": [false]},
        "externalRequests": {"type": "boolean", "enum": [false]},
        "marketing": {"type": "boolean", "enum": [false]}
      },
      "additionalProperties": false
    },
    "localizedField": {
      "type": "object",
      "required": ["label", "help", "example"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "help": {"type": "string", "minLength": 1},
        "example": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["id", "type", "privacy", "maxLength", "retainAcrossTemplates", "locales"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"},
        "type": {"type": "string", "enum": ["shortText", "longText", "url", "code", "dateTime", "amount", "boolean"]},
        "privacy": {"type": "string", "enum": ["public", "personal", "sensitive", "security", "financial"]},
        "maxLength": {"type": "integer"},
        "retainAcrossTemplates": {"type": "boolean"},
        "locales": {
          "type": "object",
          "required": ["en", "ru"],
          "properties": {
            "en": {"$ref": "#/$defs/localizedField"},
            "ru": {"$ref": "#/$defs/localizedField"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fieldReference": {
      "type": "object",
      "required": ["id", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"}
      },
      "additionalProperties": false
    },
    "detail": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"}
      },
      "additionalProperties": false
    },
    "callout": {
      "type": "object",
      "required": ["tone", "title", "text"],
      "properties": {
        "tone": {"type": "string", "enum": ["neutral", "success", "warning", "destructive"]},
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$"}
      },
      "additionalProperties": false
    },
    "cta": {
      "type": "object",
      "required": ["label", "url", "fallback"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "fallback": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "localizedTemplate": {
      "type": "object",
      "required": ["name", "summary", "subject", "preheader", "eyebrow", "title", "paragraphs", "details", "closing", "receipt"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "preheader": {"type": "string", "minLength": 1},
        "eyebrow": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "paragraphs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paragraph"}},
        "details": {"type": "array", "items": {"$ref": "#/$defs/detail"}},
        "callout": {"$ref": "#/$defs/callout"},
        "cta": {"$ref": "#/$defs/cta"},
        "closing": {"type": "string", "minLength": 1},
        "receipt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["id", "category", "channel", "risk", "allowWarmIllustration", "fields", "locales"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
        "category": {"type": "string", "enum": ["contact", "support", "account", "operation", "payment"]},
        "channel": {"type": "string", "enum": ["contact", "support"]},
        "risk": {"type": "string", "enum": ["routine", "sensitive", "security", "financial"]},
        "allowWarmIllustration": {"type": "boolean"},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldReference"}},
        "locales": {
          "type": "object",
          "required": ["en", "ru"],
          "properties": {
            "en": {"$ref": "#/$defs/localizedTemplate"},
            "ru": {"$ref": "#/$defs/localizedTemplate"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
