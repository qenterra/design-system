{
  "$schema": "../schemas/products.schema.json",
  "meta": {
    "name": "QenTerra Product Archetypes",
    "version": "5.0.0",
    "type": "products",
    "description": "Reusable inheritance and exception profiles selected by interaction model."
  },
  "immersiveContent": {
    "profile": "immersive-content",
    "density": "standard",
    "defaultNavigation": "expanded-rail",
    "keep": ["adaptive Soft Graphite palette", "persistent content hierarchy", "stable data tables", "review-first import", "persistent task controls", "queue semantics", "guide mechanics", "recoverable removal"],
    "adapt": ["navigation states", "settings containers", "buttons", "row interaction", "copy and localization", "screenshot harness"],
    "replace": ["scattered radii and durations", "duplicate navigation symbols", "suppressed hover and focus", "persistence claims stronger than reality"]
  },
  "denseOperations": {
    "profile": "operational-dense",
    "density": "compact",
    "defaultNavigation": "responsive-compact-rail",
    "keep": ["object-first hierarchy", "selection summary", "preflight", "conflict resolution", "operation history", "synthetic fixtures", "system integration"],
    "adapt": ["toolbar wrapping", "settings rows", "scoped issue architecture", "localization", "responsive navigation"],
    "replace": ["invisible filter overflow", "pristine-field errors", "unnamed toggles", "unconfirmed session discard", "global untyped errors"]
  },
  "transientCapability": {
    "profile": "transient-capability",
    "density": "compact",
    "defaultNavigation": "transient-plus-settings-sidebar",
    "keep": ["honest state vocabulary", "short semantic motion", "localization", "privacy language", "HUD", "quick history", "keycaps", "real-signal-only feedback", "diagnostics preview"],
    "adapt": ["adaptive palette", "typography", "settings components", "button roles", "onboarding requirements", "lifecycle cards"],
    "replace": ["forced appearance", "undersized typography", "generic recovery", "broken focus restoration", "fake trial flows", "stale visual sources"]
  }
}
