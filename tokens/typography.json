{
  "$schema": "../schemas/typography.schema.json",
  "meta": {
    "name": "QenTerra Typography Tokens",
    "version": "1.4.0",
    "type": "typography",
    "description": "Semantic system-font roles. Platform adapters may map to native text styles."
  },
  "family": {
    "sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif",
    "rounded": "ui-rounded, 'SF Pro Rounded', -apple-system, sans-serif",
    "mono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace"
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "roles": {
    "display": {"size": 40, "line": 48, "weight": 650, "tracking": -0.8},
    "screenTitle": {"size": 24, "line": 30, "weight": 600, "tracking": -0.35},
    "modalTitle": {"size": 20, "line": 26, "weight": 600, "tracking": -0.2},
    "sectionTitle": {"size": 15, "line": 20, "weight": 600, "tracking": -0.08},
    "body": {"size": 14, "line": 20, "weight": 400, "tracking": 0},
    "bodyEmphasized": {"size": 14, "line": 20, "weight": 550, "tracking": 0},
    "row": {"size": 13, "line": 18, "weight": 400, "tracking": 0},
    "rowEmphasized": {"size": 13, "line": 18, "weight": 550, "tracking": 0},
    "supporting": {"size": 12, "line": 17, "weight": 400, "tracking": 0},
    "metadata": {"size": 11, "line": 15, "weight": 400, "tracking": 0.08},
    "compactMetadata": {"size": 10, "line": 14, "weight": 500, "tracking": 0.16},
    "eyebrow": {"size": 11, "line": 15, "weight": 600, "tracking": 0.7, "transform": "uppercase"},
    "keycap": {"size": 12, "line": 16, "weight": 500, "tracking": 0, "family": "rounded"},
    "monospacedData": {"size": 12, "line": 17, "weight": 500, "tracking": 0, "family": "mono", "numeric": "tabular"}
  },
  "rules": {
    "minimumSupportingWeb": 12,
    "minimumSupportingNative": 11,
    "maxParagraphWidthCharacters": 76,
    "prohibitHalfPointSizes": true,
    "preferNativeDynamicStyles": true
  }
}
