{
  "$schema": "./qenterra-repository.schema.json",
  "allowed_root_paths": [
    "NOTICE",
    "Package.swift",
    "Sources",
    "Tests",
    "npm",
    "package.json",
    "release-manifest.json"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra/packages/security/advisories/new",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "5.5.0",
  "default_branch": "main",
  "dependabot_ecosystem": "npm",
  "description": "Public Swift and npm packages for QenTerra design tokens and reusable components.",
  "documentation_root": "docs",
  "ecosystem": "swift-npm",
  "exceptions": [],
  "github_features": {
    "discussions": false,
    "issues": true,
    "projects": false,
    "wiki": false
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra_repository_check.py",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DEVELOPMENT.md",
      "docs/TESTING.md",
      "docs/RELEASING.md",
      "docs/DEPENDENCIES.md",
      "docs/STYLE_GUIDE.md",
      "docs/TROUBLESHOOTING.md",
      "docs/GITHUB_SETTINGS.md",
      "docs/MAINTENANCE.md",
      "docs/decisions/README.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "CONTRIBUTING.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md",
      ".github/ISSUE_TEMPLATE/01-bug.yml",
      ".github/ISSUE_TEMPLATE/02-feature.yml",
      ".github/ISSUE_TEMPLATE/03-documentation.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/labels.yml",
      "README.md",
      "docs/REPOSITORY_STRUCTURE.md",
      "docs/OWNERSHIP.md",
      "docs/DEPRECATION.md",
      "docs/PACKAGE_RELEASE.md",
      "LICENSE",
      "NOTICE"
    ],
    "standard_version": "1.3.0"
  },
  "homepage_url": "https://github.com/QenTerra/packages",
  "install_command": "npm install @qenterra/design-tokens",
  "license": "Apache-2.0",
  "merge_strategy": "squash",
  "minimum_requirements": "Swift 5.9 or later for native packages and Node.js 22 or later for npm package verification.",
  "overlays": [
    "package"
  ],
  "primary_language": "English",
  "profile": "monorepo",
  "project_name": "QenTerra Packages",
  "published_artifacts": [
    {
      "manifest": "release-manifest.json",
      "path": "npm/design-tokens/dist",
      "purpose": "Installable CSS and JSON design-token distribution for npm consumers",
      "review_trigger": "Design-token inputs, generators, package metadata, or public artifact layout changes",
      "source": "npm/design-tokens/src",
      "verification_command": "python3 scripts/verify_release.py"
    },
    {
      "manifest": "release-manifest.json",
      "path": "Sources/QenTerra/DesignTokens/GeneratedTokens.swift",
      "purpose": "Typed Swift design-token constants consumed by the public Swift package",
      "review_trigger": "Public token inputs, generator logic, Swift adapter structure, or package version changes",
      "source": "npm/design-tokens/src",
      "verification_command": "python3 scripts/verify_release.py"
    },
    {
      "manifest": "release-manifest.json",
      "path": "Sources/QenTerra/DesignTokens/GeneratedIcons.swift",
      "purpose": "Typed SF Symbols registry consumed by the public Swift package",
      "review_trigger": "Public icon inputs, generator logic, Swift adapter structure, or package version changes",
      "source": "npm/design-tokens/src",
      "verification_command": "python3 scripts/verify_release.py"
    },
    {
      "manifest": "release-manifest.json",
      "path": "Sources/ReUI/Registry",
      "purpose": "Exact install-ready ReUI registry payloads for source-copy consumers",
      "review_trigger": "ReUI repository commit, live deployment, registry indexes, importer, or public catalog layout changes",
      "source": "Sources/ReUI/Base",
      "verification_command": "python3 scripts/verify_source_catalogs.py"
    }
  ],
  "quick_start_command": "npm pack --workspace @qenterra/design-tokens --dry-run --json",
  "release_mode": "package-registry",
  "repository_name": "packages",
  "repository_url": "https://github.com/QenTerra/packages",
  "security_url": "https://github.com/QenTerra/packages/security/advisories/new",
  "standard_version": "1.3.0",
  "support_url": "https://github.com/QenTerra/packages/issues",
  "topics": [
    "qenterra",
    "design-system",
    "design-tokens",
    "swift-package",
    "npm-package",
    "open-source"
  ],
  "verification_command": "python3 scripts/verify_release.py",
  "version_scheme": "semver",
  "version_source": "release-manifest.json",
  "version_tag_prefix": "v",
  "visibility": "public",
  "wiki_source": "disabled"
}
