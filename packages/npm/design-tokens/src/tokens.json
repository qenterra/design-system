{
  "foundation": {
    "$schema": "../schemas/foundation.schema.json",
    "meta": {
      "name": "QenTerra Foundation Tokens",
      "version": "1.0.1",
      "type": "foundation",
      "description": "Raw values. Product code should prefer semantic tokens."
    },
    "color": {
      "graphite": {
        "0": "#FFFFFF",
        "25": "#FAFAFB",
        "50": "#F4F4F6",
        "100": "#E8E8EC",
        "150": "#E0E0E6",
        "200": "#D2D2D8",
        "300": "#B9B9C0",
        "400": "#94949D",
        "500": "#6A6A73",
        "600": "#56565E",
        "700": "#3B3B41",
        "800": "#27272B",
        "850": "#202023",
        "900": "#1A1A1C",
        "950": "#171719",
        "1000": "#0F0F11"
      },
      "red": {
        "light": "#D84A42",
        "dark": "#E5695E",
        "recording": "#E5695E"
      },
      "orange": {
        "light": "#B96200",
        "dark": "#F0A342"
      },
      "green": {
        "light": "#267A3A",
        "dark": "#5EC26F"
      },
      "blue": {
        "light": "#2468C9",
        "dark": "#68A4F1"
      }
    },
    "space": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80
    },
    "radius": {
      "none": 0,
      "control": 6,
      "group": 10,
      "panel": 14,
      "hero": 18,
      "floating": 20,
      "pill": 999
    },
    "stroke": {
      "hairline": 0.5,
      "default": 1,
      "focus": 2,
      "emphasis": 2
    },
    "opacity": {
      "disabled": 0.42,
      "faint": 0.46,
      "secondary": 0.68,
      "pressed": 0.82,
      "hover": 0.045,
      "selection": 0.085,
      "selectionStrong": 0.14,
      "dividerDark": 0.13,
      "dividerLight": 0.12,
      "scrim": 0.46
    },
    "size": {
      "controlCompact": 28,
      "controlStandard": 32,
      "controlProminent": 40,
      "targetPointer": 28,
      "targetTouch": 44,
      "rowCompact": 40,
      "rowStandard": 48,
      "rowComfortable": 56,
      "railCompact": 64,
      "sidebarCompact": 214,
      "sidebarStandard": 256,
      "contentReadable": 760,
      "iconXS": 12,
      "iconS": 14,
      "iconM": 16,
      "iconL": 20,
      "iconXL": 24
    },
    "zIndex": {
      "content": 0,
      "chrome": 10,
      "popover": 30,
      "modal": 40,
      "toast": 50,
      "tooltip": 60
    }
  },
  "semantic": {
    "$schema": "../schemas/semantic.schema.json",
    "meta": {
      "name": "QenTerra Semantic Tokens",
      "version": "1.0.1",
      "type": "semantic",
      "description": "Meaning-oriented colors and materials for adaptive appearances."
    },
    "modes": {
      "light": {
        "surface": {
          "content": "{color.graphite.50}",
          "secondary": "{color.graphite.100}",
          "raised": "{color.graphite.150}",
          "chrome": "{color.graphite.25}",
          "overlay": "{color.graphite.0}",
          "inverted": "{color.graphite.950}"
        },
        "text": {
          "primary": "{color.graphite.900}",
          "secondary": "{color.graphite.600}",
          "tertiary": "{color.graphite.500}",
          "disabled": "{color.graphite.400}",
          "inverted": "{color.graphite.0}",
          "link": "{color.graphite.900}"
        },
        "action": {
          "primary": "{color.graphite.900}",
          "primaryContent": "{color.graphite.0}",
          "secondary": "{color.graphite.100}",
          "secondaryContent": "{color.graphite.900}",
          "quietContent": "{color.graphite.800}"
        },
        "border": {
          "subtle": "rgba(15, 15, 17, 0.08)",
          "default": "rgba(15, 15, 17, 0.12)",
          "strong": "rgba(15, 15, 17, 0.22)",
          "focus": "{color.graphite.900}"
        },
        "fill": {
          "hover": "rgba(15, 15, 17, 0.045)",
          "pressed": "rgba(15, 15, 17, 0.085)",
          "selected": "rgba(15, 15, 17, 0.075)",
          "selectedStrong": "rgba(15, 15, 17, 0.14)",
          "disabled": "rgba(15, 15, 17, 0.04)",
          "scrim": "rgba(15, 15, 17, 0.46)"
        },
        "shadow": {
          "raised": "0 20px 60px rgba(15, 15, 17, 0.14)",
          "floating": "0 16px 44px rgba(15, 15, 17, 0.18)",
          "overlay": "0 20px 60px rgba(15, 15, 17, 0.18)"
        },
        "state": {
          "success": "{color.green.light}",
          "warning": "{color.orange.light}",
          "destructive": "{color.red.light}",
          "informative": "{color.blue.light}",
          "recording": "{color.red.recording}"
        }
      },
      "dark": {
        "surface": {
          "content": "{color.graphite.950}",
          "secondary": "{color.graphite.850}",
          "raised": "{color.graphite.800}",
          "chrome": "{color.graphite.900}",
          "overlay": "{color.graphite.800}",
          "inverted": "{color.graphite.50}"
        },
        "text": {
          "primary": "{color.graphite.0}",
          "secondary": "{color.graphite.300}",
          "tertiary": "{color.graphite.400}",
          "disabled": "{color.graphite.500}",
          "inverted": "{color.graphite.950}",
          "link": "{color.graphite.0}"
        },
        "action": {
          "primary": "{color.graphite.0}",
          "primaryContent": "{color.graphite.950}",
          "secondary": "{color.graphite.800}",
          "secondaryContent": "{color.graphite.0}",
          "quietContent": "{color.graphite.100}"
        },
        "border": {
          "subtle": "rgba(255, 255, 255, 0.07)",
          "default": "rgba(255, 255, 255, 0.13)",
          "strong": "rgba(255, 255, 255, 0.24)",
          "focus": "{color.graphite.0}"
        },
        "fill": {
          "hover": "rgba(255, 255, 255, 0.045)",
          "pressed": "rgba(255, 255, 255, 0.085)",
          "selected": "rgba(255, 255, 255, 0.085)",
          "selectedStrong": "rgba(255, 255, 255, 0.14)",
          "disabled": "rgba(255, 255, 255, 0.04)",
          "scrim": "rgba(0, 0, 0, 0.46)"
        },
        "shadow": {
          "raised": "0 20px 60px rgba(0, 0, 0, 0.28)",
          "floating": "0 16px 44px rgba(0, 0, 0, 0.34)",
          "overlay": "0 20px 60px rgba(0, 0, 0, 0.36)"
        },
        "state": {
          "success": "{color.green.dark}",
          "warning": "{color.orange.dark}",
          "destructive": "{color.red.dark}",
          "informative": "{color.blue.dark}",
          "recording": "{color.red.recording}"
        }
      }
    },
    "material": {
      "content": {
        "kind": "opaque",
        "usage": "Reading surfaces, tables, forms, settings, media browsers"
      },
      "chrome": {
        "kind": "adaptive-translucent",
        "fallback": "surface.chrome",
        "usage": "Title bars, rails, toolbars, player chrome"
      },
      "floating": {
        "kind": "adaptive-translucent",
        "fallback": "surface.overlay",
        "usage": "HUD, command palette, transient popovers"
      }
    }
  },
  "typography": {
    "$schema": "../schemas/typography.schema.json",
    "meta": {
      "name": "QenTerra Typography Tokens",
      "version": "1.0.1",
      "type": "typography",
      "description": "Semantic system-font roles. Platform adapters may map to native text styles."
    },
    "family": {
      "sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', sans-serif",
      "rounded": "ui-rounded, 'SF Pro Rounded', -apple-system, sans-serif",
      "mono": "ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "roles": {
      "display": {
        "size": 40,
        "line": 48,
        "weight": 650,
        "tracking": -0.8
      },
      "screenTitle": {
        "size": 24,
        "line": 30,
        "weight": 600,
        "tracking": -0.35
      },
      "modalTitle": {
        "size": 20,
        "line": 26,
        "weight": 600,
        "tracking": -0.2
      },
      "sectionTitle": {
        "size": 15,
        "line": 20,
        "weight": 600,
        "tracking": -0.08
      },
      "body": {
        "size": 14,
        "line": 20,
        "weight": 400,
        "tracking": 0
      },
      "bodyEmphasized": {
        "size": 14,
        "line": 20,
        "weight": 550,
        "tracking": 0
      },
      "row": {
        "size": 13,
        "line": 18,
        "weight": 400,
        "tracking": 0
      },
      "rowEmphasized": {
        "size": 13,
        "line": 18,
        "weight": 550,
        "tracking": 0
      },
      "supporting": {
        "size": 12,
        "line": 17,
        "weight": 400,
        "tracking": 0
      },
      "metadata": {
        "size": 11,
        "line": 15,
        "weight": 400,
        "tracking": 0.08
      },
      "compactMetadata": {
        "size": 10,
        "line": 14,
        "weight": 500,
        "tracking": 0.16
      },
      "eyebrow": {
        "size": 11,
        "line": 15,
        "weight": 600,
        "tracking": 0.7,
        "transform": "uppercase"
      },
      "keycap": {
        "size": 12,
        "line": 16,
        "weight": 500,
        "tracking": 0,
        "family": "rounded"
      },
      "monospacedData": {
        "size": 12,
        "line": 17,
        "weight": 500,
        "tracking": 0,
        "family": "mono",
        "numeric": "tabular"
      }
    },
    "rules": {
      "minimumSupportingWeb": 12,
      "minimumSupportingNative": 11,
      "maxParagraphWidthCharacters": 76,
      "prohibitHalfPointSizes": true,
      "preferNativeDynamicStyles": true
    }
  },
  "motion": {
    "$schema": "../schemas/motion.schema.json",
    "meta": {
      "name": "QenTerra Motion Tokens",
      "version": "1.0.1",
      "type": "motion",
      "description": "Short, interruptible, state-explanatory motion."
    },
    "durationMs": {
      "instant": 0,
      "press": 80,
      "hover": 100,
      "floatingFast": 120,
      "present": 140,
      "replace": 150,
      "dismiss": 160,
      "disclosure": 180,
      "spatial": 220,
      "spatialLong": 240
    },
    "curve": {
      "standard": [
        0.2,
        0.0,
        0.0,
        1.0
      ],
      "enter": [
        0.16,
        1.0,
        0.3,
        1.0
      ],
      "exit": [
        0.4,
        0.0,
        1.0,
        1.0
      ],
      "linear": [
        0.0,
        0.0,
        1.0,
        1.0
      ]
    },
    "events": {
      "feedback.press": {
        "duration": "press",
        "curve": "standard",
        "properties": [
          "opacity",
          "scale<=0.98"
        ]
      },
      "feedback.hover": {
        "duration": "hover",
        "curve": "standard",
        "properties": [
          "background",
          "foreground"
        ]
      },
      "state.replace": {
        "duration": "replace",
        "curve": "standard",
        "properties": [
          "opacity"
        ]
      },
      "floating.present": {
        "duration": "present",
        "curve": "enter",
        "properties": [
          "opacity",
          "scale:0.98->1"
        ]
      },
      "floating.dismiss": {
        "duration": "dismiss",
        "curve": "exit",
        "properties": [
          "opacity",
          "scale:1->0.99"
        ]
      },
      "disclosure.toggle": {
        "duration": "disclosure",
        "curve": "standard",
        "properties": [
          "height",
          "opacity"
        ]
      },
      "navigation.spatial": {
        "duration": "spatial",
        "curve": "standard",
        "properties": [
          "transform",
          "opacity"
        ]
      },
      "progress.continuous": {
        "duration": "instant",
        "curve": "linear",
        "properties": [
          "measured-progress"
        ]
      }
    },
    "reducedMotion": {
      "maximumDurationMs": 100,
      "remove": [
        "scale",
        "translation",
        "parallax",
        "stagger",
        "auto-scroll-animation"
      ],
      "retain": [
        "opacity",
        "instant-state-replacement",
        "measured-progress"
      ]
    },
    "prohibited": [
      "layout-shifting selection",
      "decorative bounce",
      "unbounded spring",
      "cursor trail",
      "continuous ambient movement",
      "fake progress",
      "timer-based loading theatre"
    ]
  },
  "components": {
    "$schema": "../schemas/components.schema.json",
    "meta": {
      "name": "QenTerra Component Tokens",
      "version": "1.0.1",
      "type": "components",
      "description": "Shared component metrics and mandatory state contracts."
    },
    "button": {
      "heights": {
        "compact": "{size.controlCompact}",
        "standard": "{size.controlStandard}",
        "prominent": "{size.controlProminent}"
      },
      "paddingX": {
        "compact": 10,
        "standard": 12,
        "prominent": 16
      },
      "radius": "{radius.control}",
      "iconGap": "{space.2}",
      "roles": [
        "primary",
        "secondary",
        "quiet",
        "destructive",
        "icon",
        "menuRow",
        "link"
      ],
      "states": [
        "default",
        "hover",
        "pressed",
        "focused",
        "selected",
        "disabled",
        "loading"
      ]
    },
    "interactiveRow": {
      "heights": {
        "compact": "{size.rowCompact}",
        "standard": "{size.rowStandard}",
        "comfortable": "{size.rowComfortable}"
      },
      "radius": "{radius.control}",
      "paddingX": "{space.3}",
      "gap": "{space.3}",
      "states": [
        "default",
        "hover",
        "pressed",
        "focused",
        "selected",
        "disabled",
        "unavailable"
      ]
    },
    "group": {
      "radius": "{radius.group}",
      "padding": "{space.4}",
      "gap": "{space.3}",
      "border": "border.default",
      "surface": "surface.secondary"
    },
    "panel": {
      "radius": "{radius.panel}",
      "padding": "{space.5}",
      "gap": "{space.4}",
      "surface": "surface.overlay"
    },
    "field": {
      "height": "{size.controlStandard}",
      "radius": "{radius.control}",
      "paddingX": "{space.3}",
      "states": [
        "pristine",
        "editing",
        "valid",
        "invalid",
        "disabled",
        "readOnly"
      ]
    },
    "table": {
      "rowHeights": {
        "compact": "{size.rowCompact}",
        "standard": "{size.rowStandard}"
      },
      "headerHeight": "{size.controlStandard}",
      "columnGap": "{space.4}",
      "selectionRequiresTextOrShape": true,
      "sortRequiresDirection": true
    },
    "navigation": {
      "railCompact": "{size.railCompact}",
      "sidebarCompact": "{size.sidebarCompact}",
      "sidebarStandard": "{size.sidebarStandard}",
      "itemHeight": "{size.rowCompact}",
      "minimumIconTarget": "{size.targetPointer}",
      "states": [
        "default",
        "hover",
        "focused",
        "selected",
        "disabled"
      ]
    },
    "overlay": {
      "popoverMaxWidth": 360,
      "dialogReadableWidth": 480,
      "sheetReadableWidth": 640,
      "scrim": "fill.scrim",
      "focusTrapRequired": true,
      "restoreFocusRequired": true
    },
    "keycap": {
      "height": 24,
      "paddingX": 7,
      "radius": "{radius.control}",
      "gap": 4
    },
    "status": {
      "iconSize": "{size.iconS}",
      "gap": 6,
      "colorAloneForbidden": true,
      "requiredParts": [
        "symbol-or-shape",
        "plain-language-label"
      ]
    },
    "extensions": {
      "rawMetricExceptions": {
        "button.paddingX.compact": "Optical compact label inset has no reusable foundation role.",
        "button.paddingX.standard": "Optical standard label inset has no reusable foundation role.",
        "button.paddingX.prominent": "Optical prominent label inset has no reusable foundation role.",
        "overlay.popoverMaxWidth": "Readable popover cap is specific to this overlay contract.",
        "overlay.dialogReadableWidth": "Readable dialog width is specific to this overlay contract.",
        "overlay.sheetReadableWidth": "Readable sheet width is specific to this overlay contract.",
        "keycap.height": "Keycap optical height is not a general control size.",
        "keycap.paddingX": "Keycap optical inset is not a general spacing role.",
        "keycap.gap": "Keycap chord gap is intentionally tighter than component spacing.",
        "status.gap": "Status symbol and label use a deliberate optical gap."
      }
    }
  },
  "platforms": {
    "$schema": "../schemas/platforms.schema.json",
    "meta": {
      "name": "QenTerra Platform Adapters",
      "version": "1.0.1",
      "type": "platforms",
      "description": "Platform-specific constraints over the shared semantic core."
    },
    "macOS": {
      "input": "pointer-keyboard",
      "minimumTarget": 28,
      "defaultControlHeight": 32,
      "navigation": [
        "toolbar",
        "sidebar",
        "rail",
        "split-view",
        "menu-bar",
        "settings-window"
      ],
      "requirements": [
        "menu commands",
        "keyboard shortcuts",
        "resizable windows",
        "VoiceOver",
        "Reduce Motion",
        "Reduce Transparency",
        "Increase Contrast"
      ]
    },
    "iOS": {
      "input": "touch-voice-pointer-optional",
      "minimumTarget": 44,
      "defaultControlHeight": 44,
      "navigation": [
        "navigation-stack",
        "tab-bar",
        "sheet",
        "full-screen-cover"
      ],
      "requirements": [
        "Dynamic Type",
        "VoiceOver",
        "safe areas",
        "orientation",
        "Reduce Motion",
        "Increase Contrast"
      ]
    },
    "iPadOS": {
      "input": "touch-pointer-keyboard",
      "minimumTarget": 44,
      "defaultControlHeight": 44,
      "navigation": [
        "navigation-split-view",
        "sidebar",
        "toolbar",
        "inspector",
        "multiwindow"
      ],
      "requirements": [
        "Stage Manager",
        "keyboard",
        "pointer",
        "Dynamic Type",
        "multitasking widths"
      ]
    },
    "web": {
      "input": "pointer-keyboard-touch",
      "minimumTargetPointer": 32,
      "minimumTargetTouch": 44,
      "breakpoints": {
        "compact": 480,
        "medium": 768,
        "wide": 1024,
        "max": 1440
      },
      "requirements": [
        "WCAG 2.2 AA",
        "semantic HTML",
        "focus-visible",
        "200% zoom",
        "reduced motion",
        "forced colors",
        "print"
      ]
    },
    "browserExtension": {
      "input": "pointer-keyboard-touch-possible",
      "minimumTargetPointer": 32,
      "minimumTargetTouch": 44,
      "layouts": [
        "popup",
        "side-panel",
        "overlay-dock",
        "bottom-sheet",
        "options-page"
      ],
      "requirements": [
        "viewport clamping",
        "host-page isolation",
        "focus return",
        "200% zoom",
        "i18n expansion",
        "reduced motion"
      ]
    }
  },
  "products": {
    "$schema": "../schemas/products.schema.json",
    "meta": {
      "name": "QenTerra Product Archetypes",
      "version": "1.0.1",
      "type": "products",
      "description": "Reusable inheritance and exception profiles selected by interaction model."
    },
    "immersiveContent": {
      "profile": "immersive-content",
      "density": "standard",
      "defaultNavigation": "expanded-rail",
      "keep": [
        "adaptive Soft Graphite palette",
        "persistent content hierarchy",
        "stable data tables",
        "review-first import",
        "persistent task controls",
        "queue semantics",
        "guide mechanics",
        "recoverable removal"
      ],
      "adapt": [
        "navigation states",
        "settings containers",
        "buttons",
        "row interaction",
        "copy and localization",
        "screenshot harness"
      ],
      "replace": [
        "scattered radii and durations",
        "duplicate navigation symbols",
        "suppressed hover and focus",
        "persistence claims stronger than reality"
      ]
    },
    "denseOperations": {
      "profile": "operational-dense",
      "density": "compact",
      "defaultNavigation": "responsive-compact-rail",
      "keep": [
        "object-first hierarchy",
        "selection summary",
        "preflight",
        "conflict resolution",
        "operation history",
        "synthetic fixtures",
        "system integration"
      ],
      "adapt": [
        "toolbar wrapping",
        "settings rows",
        "scoped issue architecture",
        "localization",
        "responsive navigation"
      ],
      "replace": [
        "invisible filter overflow",
        "pristine-field errors",
        "unnamed toggles",
        "unconfirmed session discard",
        "global untyped errors"
      ]
    },
    "transientCapability": {
      "profile": "transient-capability",
      "density": "compact",
      "defaultNavigation": "transient-plus-settings-sidebar",
      "keep": [
        "honest state vocabulary",
        "short semantic motion",
        "localization",
        "privacy language",
        "HUD",
        "quick history",
        "keycaps",
        "real-signal-only feedback",
        "diagnostics preview"
      ],
      "adapt": [
        "adaptive palette",
        "typography",
        "settings components",
        "button roles",
        "onboarding requirements",
        "lifecycle cards"
      ],
      "replace": [
        "forced appearance",
        "undersized typography",
        "generic recovery",
        "broken focus restoration",
        "fake trial flows",
        "stale visual sources"
      ]
    }
  }
}
