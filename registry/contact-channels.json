{
  "$schema": "../schemas/contact-channels.schema.json",
  "version": "1.7.0",
  "channels": [
    {
      "id": "contact",
      "address": "contact@qenterra.com",
      "purpose": "General company and brand communication.",
      "useFor": ["general inquiries", "partnerships", "press", "business and legal correspondence"],
      "doNotUseFor": ["product troubleshooting", "bug reports", "private vulnerability reports"]
    },
    {
      "id": "support",
      "address": "support@qenterra.com",
      "purpose": "Help with QenTerra products and services.",
      "useFor": ["product help", "troubleshooting", "bug reports", "accessibility support"],
      "doNotUseFor": ["partnerships and press", "private vulnerability reports"]
    }
  ]
}
