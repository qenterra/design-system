{
  "$schema": "../schemas/package-registry.schema.json",
  "version": "5.0.0",
  "repository": "https://github.com/qenterra/packages",
  "versionPolicy": "shared",
  "packages": [
    {
      "id": "repository-metadata",
      "ecosystem": "repository",
      "name": "qenterra/packages",
      "version": "5.0.0",
      "publicPaths": [
        "packages/.editorconfig",
        "packages/.gitattributes",
        "packages/.github/CODEOWNERS",
        "packages/.github/ISSUE_TEMPLATE/01-bug.yml",
        "packages/.github/ISSUE_TEMPLATE/02-feature.yml",
        "packages/.github/ISSUE_TEMPLATE/03-documentation.yml",
        "packages/.github/ISSUE_TEMPLATE/config.yml",
        "packages/.github/PULL_REQUEST_TEMPLATE.md",
        "packages/.github/dependabot.yml",
        "packages/.github/labels.yml",
        "packages/.github/qenterra-repository.json",
        "packages/.github/qenterra-repository.schema.json",
        "packages/.github/release.yml",
        "packages/.github/workflows/ci.yml",
        "packages/.github/workflows/repository-governance.yml",
        "packages/.gitignore",
        "packages/AUTHORS.md",
        "packages/CHANGELOG.md",
        "packages/CODE_OF_CONDUCT.md",
        "packages/CONTRIBUTING.md",
        "packages/GOVERNANCE.md",
        "packages/LICENSE",
        "packages/MAINTAINERS.md",
        "packages/NOTICE",
        "packages/Package.swift",
        "packages/README.md",
        "packages/SECURITY.md",
        "packages/SUPPORT.md",
        "packages/THIRD_PARTY_NOTICES.md",
        "packages/docs/ARCHITECTURE.md",
        "packages/docs/DEPENDENCIES.md",
        "packages/docs/DEPRECATION.md",
        "packages/docs/DEVELOPMENT.md",
        "packages/docs/GITHUB_SETTINGS.md",
        "packages/docs/MAINTENANCE.md",
        "packages/docs/OWNERSHIP.md",
        "packages/docs/PACKAGE_RELEASE.md",
        "packages/docs/README.md",
        "packages/docs/RELEASING.md",
        "packages/docs/REPOSITORY_STRUCTURE.md",
        "packages/docs/STYLE_GUIDE.md",
        "packages/docs/TESTING.md",
        "packages/docs/TROUBLESHOOTING.md",
        "packages/docs/decisions/0000-template.md",
        "packages/docs/decisions/README.md",
        "packages/package.json",
        "packages/scripts/generate.py",
        "packages/scripts/lib/__init__.py",
        "packages/scripts/lib/token_tools.py",
        "packages/scripts/qenterra_repository_check.py",
        "packages/scripts/verify_release.py"
      ],
      "tests": [],
      "capabilities": []
    },
    {
      "id": "npm-design-tokens",
      "ecosystem": "npm",
      "name": "@qenterra/design-tokens",
      "version": "5.0.0",
      "publicPaths": [
        "packages/npm/design-tokens/LICENSE",
        "packages/npm/design-tokens/NOTICE",
        "packages/npm/design-tokens/README.md",
        "packages/npm/design-tokens/package.json",
        "packages/npm/design-tokens/schemas/components.schema.json",
        "packages/npm/design-tokens/schemas/foundation.schema.json",
        "packages/npm/design-tokens/schemas/icon-registry.schema.json",
        "packages/npm/design-tokens/schemas/motion.schema.json",
        "packages/npm/design-tokens/schemas/platforms.schema.json",
        "packages/npm/design-tokens/schemas/products.schema.json",
        "packages/npm/design-tokens/schemas/semantic.schema.json",
        "packages/npm/design-tokens/schemas/token-file.schema.json",
        "packages/npm/design-tokens/schemas/typography.schema.json",
        "packages/npm/design-tokens/src/icons.json",
        "packages/npm/design-tokens/src/index.css",
        "packages/npm/design-tokens/src/recipes.css",
        "packages/npm/design-tokens/src/tokens.json",
        "packages/npm/design-tokens/dist/icons.json",
        "packages/npm/design-tokens/dist/recipes.css",
        "packages/npm/design-tokens/dist/tokens.css",
        "packages/npm/design-tokens/dist/tokens.json"
      ],
      "tests": [
        "tests/package-css-smoke.mjs"
      ],
      "capabilities": [
        "tokens.css",
        "tokens.json",
        "icons.json",
        "button.recipe",
        "field.recipe",
        "group.recipe",
        "interactive-row.recipe"
      ]
    },
    {
      "id": "swift-components",
      "ecosystem": "swiftpm",
      "name": "QenTerraPackages",
      "version": "5.0.0",
      "products": [
        "QenTerraDesignTokens",
        "QenTerraComponents"
      ],
      "publicPaths": [
        "packages/Sources/QenTerraDesignTokens/DesignTokens.swift",
        "packages/Sources/QenTerraDesignTokens/GeneratedIcons.swift",
        "packages/Sources/QenTerraDesignTokens/GeneratedTokens.swift",
        "packages/Sources/QenTerraDesignTokens/SwiftUIAdapters.swift",
        "packages/Sources/QenTerraComponents/Components.swift",
        "packages/Tests/QenTerraDesignTokensTests/DesignTokensTests.swift",
        "packages/Tests/QenTerraComponentsTests/ComponentTests.swift"
      ],
      "tests": [
        "packages/Tests/QenTerraDesignTokensTests/DesignTokensTests.swift",
        "packages/Tests/QenTerraComponentsTests/ComponentTests.swift"
      ],
      "capabilities": [
        "typed-tokens",
        "swiftui-token-adapters",
        "primary-button-style",
        "group-container",
        "interactive-row-surface"
      ]
    }
  ]
}
