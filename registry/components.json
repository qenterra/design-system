{
  "$schema": "../schemas/component-registry.schema.json",
  "version": "1.8.1",
  "components": [
    {
      "id": "button",
      "name": {"en": "Button", "ru": "Кнопка"},
      "summary": {"en": "Starts one explicit action with a truthful role and state.", "ru": "Запускает одно явное действие с честной ролью и состоянием."},
      "anatomy": ["label", "optional-leading-icon", "optional-progress"],
      "states": ["default", "hover", "pressed", "focused", "disabled", "loading"],
      "stories": [
        {"id": "primary", "state": "default", "variant": "primary"},
        {"id": "secondary", "state": "default", "variant": "secondary"},
        {"id": "disabled", "state": "disabled", "variant": "primary"},
        {"id": "long-copy", "state": "default", "variant": "secondary", "localeWidth": "long"}
      ],
      "accessibility": ["native-button", "visible-focus", "disabled-state-announced", "loading-name-stable"]
    },
    {
      "id": "field",
      "name": {"en": "Field", "ru": "Поле"},
      "summary": {"en": "Collects one value with persistent label, help, and validation.", "ru": "Принимает одно значение с постоянной меткой, подсказкой и проверкой."},
      "anatomy": ["label", "control", "optional-help", "optional-error"],
      "states": ["pristine", "editing", "valid", "invalid", "disabled", "readOnly"],
      "stories": [
        {"id": "pristine", "state": "pristine"},
        {"id": "invalid", "state": "invalid"},
        {"id": "disabled", "state": "disabled"},
        {"id": "rtl", "state": "pristine", "localeWidth": "rtl"}
      ],
      "accessibility": ["programmatic-label", "described-error", "error-not-color-only", "autocomplete-explicit"]
    },
    {
      "id": "interactive-row",
      "name": {"en": "Interactive row", "ru": "Интерактивная строка"},
      "summary": {"en": "Presents a dominant label and one row-level action or selection.", "ru": "Показывает главный текст и одно действие или выбор на уровне строки."},
      "anatomy": ["leading-symbol", "primary-label", "supporting-text", "trailing-control"],
      "states": ["default", "hover", "focused", "selected", "disabled", "unavailable"],
      "stories": [
        {"id": "default", "state": "default"},
        {"id": "selected", "state": "selected"},
        {"id": "unavailable", "state": "unavailable"}
      ],
      "accessibility": ["single-focus-target", "selection-announced", "status-has-text"]
    },
    {
      "id": "group",
      "name": {"en": "Group", "ru": "Группа"},
      "summary": {"en": "Collects related controls under one plain-language heading.", "ru": "Объединяет связанные элементы под понятным заголовком."},
      "anatomy": ["heading", "optional-summary", "content"],
      "states": ["default", "disabled"],
      "stories": [{"id": "settings", "state": "default"}, {"id": "long-copy", "state": "default", "localeWidth": "long"}],
      "accessibility": ["fieldset-or-labelled-region", "heading-order", "children-remain-focusable"]
    },
    {
      "id": "dialog",
      "name": {"en": "Dialog", "ru": "Диалог"},
      "summary": {"en": "Interrupts only for a bounded decision that cannot stay inline.", "ru": "Прерывает поток только ради ограниченного решения, которое нельзя оставить встроенным."},
      "anatomy": ["title", "consequence", "content", "actions", "close-control"],
      "states": ["presented", "busy", "error"],
      "stories": [{"id": "confirmation", "state": "presented"}, {"id": "error", "state": "error"}],
      "accessibility": ["dialog-role", "labelled-title", "focus-trap", "focus-restored", "escape-when-safe"]
    },
    {
      "id": "status",
      "name": {"en": "Status", "ru": "Статус"},
      "summary": {"en": "Communicates outcome with words and shape, never color alone.", "ru": "Передаёт результат словами и формой, никогда только цветом."},
      "anatomy": ["symbol-or-shape", "plain-language-label", "optional-detail"],
      "states": ["success", "warning", "destructive", "informative", "recording"],
      "stories": [{"id": "success", "state": "success"}, {"id": "warning", "state": "warning"}, {"id": "error", "state": "destructive"}],
      "accessibility": ["live-region-only-when-needed", "meaning-beyond-color", "no-icon-only-outcome"]
    }
  ]
}
