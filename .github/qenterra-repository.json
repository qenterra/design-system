{
  "$schema": "./qenterra-repository.schema.json",
  "allowed_root_paths": [
    ".npmrc",
    ".nvmrc",
    "AGENTS.md",
    "SKILL.md",
    "VERSION",
    "assets",
    "generated",
    "package-lock.json",
    "package.json",
    "packages",
    "registry",
    "requirements-visual.txt",
    "schemas",
    "scripts",
    "templates",
    "tests",
    "tokens"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra/design-system/security/advisories/new",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "5.0.0",
  "default_branch": "main",
  "dependabot_ecosystem": "npm",
  "description": "Private canonical design system for QenTerra foundations, components, assets, and public package delivery.",
  "documentation_root": "docs",
  "ecosystem": "python-node-swift",
  "exceptions": [],
  "github_features": {
    "discussions": false,
    "issues": true,
    "projects": false,
    "wiki": false
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra_repository_check.py",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DEVELOPMENT.md",
      "docs/TESTING.md",
      "docs/RELEASING.md",
      "docs/DEPENDENCIES.md",
      "docs/STYLE_GUIDE.md",
      "docs/TROUBLESHOOTING.md",
      "docs/GITHUB_SETTINGS.md",
      "docs/MAINTENANCE.md",
      "docs/decisions/README.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "CONTRIBUTING.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md",
      ".github/ISSUE_TEMPLATE/01-bug.yml",
      ".github/ISSUE_TEMPLATE/02-feature.yml",
      ".github/ISSUE_TEMPLATE/03-documentation.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/labels.yml",
      "README.md",
      "docs/REPOSITORY_STRUCTURE.md",
      "docs/OWNERSHIP.md",
      "docs/DEPRECATION.md",
      "docs/PACKAGE_RELEASE.md",
      "LICENSE"
    ],
    "standard_version": "1.2.0"
  },
  "homepage_url": "https://github.com/QenTerra/design-system",
  "install_command": "npm ci --ignore-scripts",
  "license": "Proprietary",
  "merge_strategy": "squash",
  "minimum_requirements": "Python 3.11 or later, Node.js 22 or later, Swift 5.9 or later, and full Xcode for package tests.",
  "overlays": [
    "package"
  ],
  "primary_language": "English",
  "profile": "monorepo",
  "project_name": "QenTerra Design System",
  "published_artifacts": [],
  "quick_start_command": "python3 scripts/generate.py check",
  "release_mode": "none",
  "repository_name": "design-system",
  "repository_url": "https://github.com/QenTerra/design-system",
  "security_url": "https://github.com/QenTerra/design-system/security/advisories/new",
  "standard_version": "1.2.0",
  "support_url": "https://github.com/QenTerra/design-system/issues",
  "topics": [
    "qenterra",
    "design-system",
    "design-tokens",
    "swift",
    "css",
    "accessibility"
  ],
  "verification_command": "python3 scripts/verify.py",
  "version_scheme": "semver",
  "version_source": "VERSION",
  "version_tag_prefix": "v",
  "visibility": "private",
  "wiki_source": "disabled"
}
