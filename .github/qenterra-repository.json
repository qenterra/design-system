{
  "$schema": "./qenterra-repository.schema.json",
  "agent_control_plane": false,
  "allowed_root_paths": [
    ".npmrc",
    ".nvmrc",
    "Package.swift",
    "VERSION",
    "assets",
    "generated",
    "package-lock.json",
    "package.json",
    "packages",
    "registry",
    "requirements-visual.txt",
    "schemas",
    "scripts",
    "templates",
    "tests",
    "tokens"
  ],
  "branch_prefix": "qenterra/",
  "code_owner": "@qenterra",
  "collaboration_model": "solo",
  "conduct_contact": "https://github.com/QenTerra/design-system/security/advisories/new",
  "copyright_holder": "Nikita Melnychenko (QenTerra)",
  "copyright_year_range": "2026",
  "current_version": "1.0.0",
  "default_branch": "main",
  "dependabot_ecosystem": "npm",
  "description": "Public canonical design system for QenTerra foundations, components, assets, and package delivery.",
  "documentation_root": "docs",
  "ecosystem": "python-node-swift",
  "exceptions": [],
  "github_features": {
    "discussions": false,
    "issues": true,
    "projects": false,
    "wiki": false
  },
  "github_owner": "QenTerra",
  "governance": {
    "generator": "Noetic QenTerra repository templates",
    "required_files": [
      ".github/qenterra-repository.json",
      "CHANGELOG.md",
      "SECURITY.md",
      "GOVERNANCE.md",
      "MAINTAINERS.md",
      "AUTHORS.md",
      "THIRD_PARTY_NOTICES.md",
      ".github/CODEOWNERS",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/release.yml",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".github/qenterra-repository.schema.json",
      ".github/workflows/repository-governance.yml",
      "scripts/qenterra_repository_check.py",
      "docs/README.md",
      "docs/ARCHITECTURE.md",
      "docs/DEVELOPMENT.md",
      "docs/TESTING.md",
      "docs/RELEASING.md",
      "docs/DEPENDENCIES.md",
      "docs/STYLE_GUIDE.md",
      "docs/TROUBLESHOOTING.md",
      "docs/GITHUB_SETTINGS.md",
      "docs/MAINTENANCE.md",
      "docs/decisions/README.md",
      "docs/decisions/0000-template.md",
      ".github/dependabot.yml",
      "CONTRIBUTING.md",
      "CODE_OF_CONDUCT.md",
      "SUPPORT.md",
      ".github/ISSUE_TEMPLATE/01-bug.yml",
      ".github/ISSUE_TEMPLATE/02-feature.yml",
      ".github/ISSUE_TEMPLATE/03-documentation.yml",
      ".github/ISSUE_TEMPLATE/config.yml",
      ".github/labels.yml",
      "README.md",
      "docs/REPOSITORY_STRUCTURE.md",
      "docs/OWNERSHIP.md",
      "docs/DEPRECATION.md",
      "docs/PACKAGE_RELEASE.md",
      "LICENSE",
      "NOTICE"
    ],
    "standard_version": "2.0.0"
  },
  "homepage_url": "https://github.com/QenTerra/design-system",
  "install_command": "npm ci --ignore-scripts",
  "license": "Apache-2.0",
  "merge_strategy": "squash",
  "minimum_requirements": "Python 3.11 or later, Node.js 22 or later, Swift 5.9 or later, and full Xcode for package tests.",
  "overlays": [
    "package"
  ],
  "primary_language": "English",
  "profile": "monorepo",
  "project_name": "QenTerra Design System",
  "published_artifacts": [
    {
      "manifest": "registry/published-artifacts.json",
      "path": "packages/npm/design-tokens/dist",
      "purpose": "Installable CSS and JSON design-token distribution for npm consumers",
      "review_trigger": "Design-token inputs, generators, package metadata, or public artifact layout changes",
      "source": "packages/npm/design-tokens/src",
      "verification_command": "python3 scripts/verify.py"
    },
    {
      "manifest": "registry/published-artifacts.json",
      "path": "packages/Sources/QenTerra/DesignTokens/GeneratedTokens.swift",
      "purpose": "Typed Swift design-token constants consumed by the public Swift package",
      "review_trigger": "Public token inputs, generator logic, Swift adapter structure, or package version changes",
      "source": "packages/npm/design-tokens/src",
      "verification_command": "python3 scripts/verify.py"
    },
    {
      "manifest": "registry/published-artifacts.json",
      "path": "packages/Sources/QenTerra/DesignTokens/GeneratedIcons.swift",
      "purpose": "Typed SF Symbols registry consumed by the public Swift package",
      "review_trigger": "Public icon inputs, generator logic, Swift adapter structure, or package version changes",
      "source": "packages/npm/design-tokens/src",
      "verification_command": "python3 scripts/verify.py"
    },
    {
      "manifest": "registry/published-artifacts.json",
      "path": "generated",
      "purpose": "Generated token reference and design-tool handoff data for Design System consumers",
      "review_trigger": "Token, icon registry, component registry, or handoff generator changes",
      "source": "tokens",
      "verification_command": "python3 scripts/verify.py"
    },
    {
      "manifest": "registry/published-artifacts.json",
      "path": "packages/Sources/ReUI/Registry",
      "purpose": "Exact install-ready ReUI registry payloads for source-copy consumers",
      "review_trigger": "ReUI repository commit, live deployment, registry indexes, importer, or package catalog changes",
      "source": "packages/Sources/ReUI/Base",
      "verification_command": "python3 scripts/verify.py"
    }
  ],
  "quick_start_command": "python3 scripts/generate.py check",
  "release_mode": "package-registry",
  "repository_name": "design-system",
  "repository_url": "https://github.com/QenTerra/design-system",
  "security_url": "https://github.com/QenTerra/design-system/security/advisories/new",
  "standard_version": "2.0.0",
  "support_url": "https://github.com/QenTerra/design-system/issues",
  "topics": [
    "qenterra",
    "design-system",
    "design-tokens",
    "swift",
    "css",
    "accessibility"
  ],
  "verification_command": "python3 scripts/verify.py",
  "version_scheme": "semver",
  "version_source": "VERSION",
  "version_tag_prefix": "v",
  "visibility": "public",
  "wiki_source": "disabled"
}
